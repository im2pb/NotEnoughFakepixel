{
    "schemaVersion": 1,
    "id": "notenoughfakepixel",
    "version": "${version}",
    "name": "NotEnoughFakepixel",
    "description": "Client-side utilities for Fakepixel.",
    "license": "LGPL-3.0-or-later",
    "environment": "client",
    "accessWidener": "notenoughfakepixel.accesswidener",
    "mixins": ["notenoughfakepixel.mixins.json"],
    "entrypoints": {
        "client": [
            "com.nef.notenoughfakepixel.NotEnoughFakepixelClient"
        ]
    },
    "depends": {
        "fabricloader": ">=${loaderVersion}",
        "fabric-command-api-v2": "*",
        "fabric-key-binding-api-v1": "*",
        "fabric-lifecycle-events-v1": "*",
        "fabric-message-api-v1": "*",
        "fabric-networking-api-v1": "*",
        "fabric-rendering-v1": "*",
        "fabric-resource-loader-v0": "*",
        "fabric-screen-api-v1": "*",
        "minecraft": "${minecraftVersion}",
        "java": ">=21"
    }
}
